# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Port the Node/MySQL storefront listens on
PORT=8080

# Used only by the protected manual Sheet -> MySQL final import (/admin/sync).
# Storefront /api requests never use this legacy endpoint.
API_PHP_URL=https://fluxfilm.in/api.php
API_KEY=CHANGE_ME_shared_secret

# Admin panel sign-in password (12+ characters). Changing it signs everyone out.
ADMIN_PASSWORD=CHANGE_ME_long_admin_password
# Optional: hours a sign-in lasts (default 12)
# ADMIN_SESSION_HOURS=12

# Key for scripts only, sent as the X-Admin-Key header (no longer accepted in URLs)
CACHE_CLEAR_KEY=CHANGE_ME_cache_key

# Extra sites allowed to call /api from a browser (comma-separated). FluxFilm domains are built in.
# CORS_ORIGINS=

# MySQL is the storefront master
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=CHANGE_ME_database
DB_USER=CHANGE_ME_user
DB_PASS=CHANGE_ME_password

# Keep automatic legacy imports disabled
SYNC_INTERVAL_MIN=0

TZ=Asia/Kolkata
