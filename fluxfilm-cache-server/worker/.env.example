# Copy to .env and fill in. Nothing in here is ever committed.

# The shop. The worker only ever talks to this.
FF_BASE=https://shop.fluxfilm.in
# The admin key (same one the panel uses). Header only — never in a URL.
FF_ADMIN_KEY=

# A label so the owner can see WHICH machine took a job: laptop, vps, box…
FF_WORKER_NAME=laptop

# Where the signed-in browser profiles live. One folder per account.
# Moving the worker to another machine = copy this folder, or sign in again there.
FF_PROFILE_DIR=./profiles

# How often to ask for work, in milliseconds.
FF_POLL_MS=15000

# off = show the browser (useful while watching it work the first few times)
FF_HEADLESS=on

# Failures on one account before the worker stops touching it until restarted.
FF_MAX_FAILS=3
