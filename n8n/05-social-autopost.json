    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $json;\nconst tags = (p.genres || []).slice(0, 3).map((g) => '#' + String(g).replace(/[^A-Za-z0-9]/g, '')).filter((t) => t.length > 1);\nconst lines = [\n  '🍿 ' + p.title + (p.seasonLabel ? ' · ' + p.seasonLabel : ''),\n  p.brand ? 'Now on ' + p.brand : '',\n  '',\n  String(p.caption || '').slice(0, 600),\n  '',\n  p.ctaService && p.fromPriceText ? '🎟️ Get ' + p.ctaService + ' ' + p.fromPriceText + ' on FluxFilm' : '🎟️ Watch it with FluxFilm',\n  '👉 ' + p.shareUrl,\n  p.trailerUrl ? '▶️ Trailer: ' + p.trailerUrl : '',\n  '',\n  tags.concat(['#FluxFilm', '#NewOnOTT']).join(' '),\n].filter((l, i, a) => !(l === '' && a[i - 1] === ''));\nconst caption = lines.join('\\n').trim();\nreturn { json: Object.assign({}, p, { caption, telegramCaption: caption.slice(0, 1000), hasImage: !!p.imageUrl }) };"
      },
      "id": "ff1b71f3-433a-4d3e-ac0e-987e31ff5028",
