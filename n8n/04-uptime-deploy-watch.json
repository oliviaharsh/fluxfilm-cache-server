      "id": "11922f4f-2b93-4b91-a38b-79147921ee34",
      "name": "Shop health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "FluxFilm n8n key"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const ms = Date.now() - $('Start timer').first().json.startedAt;\nconst r = $input.first().json || {};\nconst code = Number(r.statusCode || 0);\nconst body = r.body || {};\nconst dbOk = !!(body.db && body.db.ok);\nlet problem = '';\nif (r.error || !code) problem = 'No answer (' + String((r.error && r.error.message) || r.error || 'timeout') + ')';\nelse if (code !== 200) problem = 'HTTP ' + code;\nelse if (!dbOk) problem = 'Database is DOWN' + (body.db && body.db.error ? ': ' + body.db.error : '');\nelse if (ms > 5000) problem = 'Very slow: ' + ms + ' ms';\nconst mem = $getWorkflowStaticData('global');\nconst wasDown = !!mem.down;\nconst down = !!problem;\nlet send = '';\nif (down && !wasDown) { mem.down = true; mem.since = new Date().toISOString(); send = 'down'; }\nif (!down && wasDown) { send = 'up'; mem.down = false; }\nconst since = mem.since || '';\nif (!down) mem.since = '';\nconst when = new Date(Date.now() + 5.5 * 3600e3).toISOString().slice(0, 16).replace('T', ' ');\nconst text = send === 'down'\n  ? '🔴 FluxFilm shop problem (' + when + ' IST): ' + problem + '\\nhttps://shop.fluxfilm.in'\n  : '✅ FluxFilm shop is back (' + when + ' IST). Down since ' + since + '. Answer ' + ms + ' ms.';\nreturn [{ json: { send, problem, ms, code, dbOk, text } }];"
      },
