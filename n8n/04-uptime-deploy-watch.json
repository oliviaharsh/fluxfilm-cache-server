    {
      "parameters": {
        "jsCode": "const mem = $getWorkflowStaticData('global');\nconst sha = $input.first().json.sha;\nif (!sha || mem.lastSha === sha) return [];\nconst first = !mem.lastSha;\nmem.lastSha = sha;\nif (first) return []; // first run only remembers the current commit\nreturn [{ json: { after: sha, head_commit: { message: ($input.first().json.commit || {}).message || '' } } }];"
      },
      "id": "0653f620-2e3f-4584-adf1-f75d5e8cfe56",
      "name": "New commit? (disabled)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
