    {
      "parameters": {
        "jsCode": "const c = $('Commit info').first().json;\nconst want = { serverJs: String($('sha256 server.js').last().json.serverHash || '').slice(0, 12), indexHtml: String($('sha256 index.html').last().json.indexHash || '').slice(0, 12) };\nconst live = ($input.first().json && $input.first().json.build) || {};\nconst same = !!want.serverJs && want.serverJs === live.serverJs && want.indexHtml === live.indexHtml;\nconst tries = $runIndex + 1; // this node runs once per check (4, 8, 12 minutes)\nconst text = '⚠️ Hostinger did not deploy commit ' + c.short + ' (' + c.message + ') after ' + (tries * 4) + ' minutes.\\nGitHub server.js ' + want.serverJs + ' / index.html ' + want.indexHtml + '\\nLive     server.js ' + (live.serverJs || '?') + ' / index.html ' + (live.indexHtml || '?') + '\\n👉 Open hPanel → Websites → shop.fluxfilm.in → Node.js app → press Redeploy.';\nreturn [{ json: { same, tries, want, live, text, sha: c.sha } }];"
      },
