    {
      "parameters": {
        "jsCode": "// Works for the GitHub trigger (body.after) and the polling path (after).\nconst APP_DIR = 'fluxfilm-cache-server/';\nconst j = $input.first().json;\nconst b = j.body || j;\nconst sha = String(b.after || '');\nif (!/^[0-9a-f]{40}$/.test(sha)) return [];\nconst message = String((b.head_commit && b.head_commit.message) || '').split('\\n')[0].slice(0, 120);\nreturn [{ json: { sha, short: sha.slice(0, 7), message, appDir: APP_DIR } }];"
      },
